# llm (only for groq / auto mode)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# auth (required)
JWT_SECRET_KEY=

# database (sqlite if unset, postgres in production)
DATABASE_URL=

# attachments storage (optional, s3-compatible)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
NEON_BUCKET_NAME=uploads

# oauth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# public url of the backend
BACKEND_BASE_URL=http://localhost:8000
