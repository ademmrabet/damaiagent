# Copy this file to .env and fill in what you need. .env is already in
# .gitignore - never commit real keys.

# Only needed if you use the "Groq" or "Auto" LLM mode.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Only needed if your local Ollama isn't at the default address, or you
# want a different local model than the default (llama3.1).
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Authentication ---

# Signs and verifies JWTs. There is no default - the app refuses to
# start without one, on purpose (see webapp/auth.py). Generate a real
# one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Where the users table lives. Leave unset for local development -
# falls back to a SQLite file (local_dev.db). In production this MUST
# point at a real Postgres instance with a persistent disk (e.g. a
# free Neon project's connection string) - Render's own free tier has
# no persistent disk, so a SQLite file there gets wiped on every
# redeploy. Format: postgresql://user:password@host/dbname
DATABASE_URL=

# --- OAuth (Google / Microsoft sign-in) ---
# Leave blank until you've registered the apps - see docs/oauth_setup.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# The backend's own public base URL, used to build the OAuth redirect
# URIs (e.g. https://your-app.onrender.com). Locally this is your dev
# server address.
BACKEND_BASE_URL=http://localhost:8000
